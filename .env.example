# Optional. Without a key the summary uses the built-in template.
GROQ_API_KEY=
GROQ_MODEL=

# TRUST_PROXY_HEADERS=true   # read the visitor IP from Netlify's x-nf-client-connection-ip, then X-Forwarded-For (default true)
# LOG_IP_MODE=full           # full | truncated (zero the last IPv4 octet / last 80 bits of IPv6)
